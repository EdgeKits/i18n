{
  "name": "@edgekits/i18n-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @edgekits/i18n-core && npm run build -w @edgekits/astro-i18n -w @edgekits/tanstack-i18n",
    "test": "npm run build -w @edgekits/i18n-core && npm test --workspaces --if-present",
    "typecheck": "npm run build -w @edgekits/i18n-core && npm run typecheck --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261028.1",
    "@types/node": "^25.9.1",
    "prettier": "3.9.4",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
