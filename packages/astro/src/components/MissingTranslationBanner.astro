---
import { checkMissingTranslation } from '../resolve-locale'

interface Props {
  // The project's copy for both cases, from its own translations: the engine fetches
  // nothing here and assumes no namespace. `content`: the page's content is missing in
  // the selected language; `ui`: the interface is not fully translated.
  texts: { content: string; ui: string }
  // Headless: the class comes from here; without it the banner renders no `class`.
  classes?: Partial<Record<'root', string>>
}

const { texts, classes = {} } = Astro.props
const { uiLocale, isMissingContent } = Astro.locals

const missingType = checkMissingTranslation(uiLocale, isMissingContent)

let bannerText: string | null = null

if (missingType) {
  bannerText = missingType === 'content' ? texts.content : texts.ui
}
---

{
  bannerText && (
    <div class={classes.root} data-missing={missingType}>
      {bannerText}
    </div>
  )
}
