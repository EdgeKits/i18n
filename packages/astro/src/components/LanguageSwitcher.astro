---
import { I18N_CONFIG } from '../config'
import { SUPPORTED_LOCALES, LANGUAGES, LANG_COOKIE_NAME } from '../constants'
import type { Locale } from '../constants'

interface Props {
  // The project's flag component (an Astro component reference), passed in so the
  // engine imports no project UI. It receives the locale's `countryCode`; without the
  // component, or for a locale without a `countryCode`, the item renders label-only.
  flag?: (props: { code: string; size?: number }) => any
  // The project's icons for the trigger button and the active item (Astro component
  // references, like `flag`). Without them, the minimal inline defaults below render.
  triggerIcon?: (props: Record<string, unknown>) => any
  activeIcon?: (props: Record<string, unknown>) => any
  // The component is headless: every class comes from here. A slot left out renders no
  // `class` attribute; `itemActive` is appended to `item` on the active entry.
  classes?: Partial<
    Record<'root' | 'trigger' | 'triggerIcon' | 'dropdown' | 'item' | 'itemActive' | 'itemLabel' | 'activeIcon', string>
  >
  // The component's own words, like MissingTranslationBanner's `texts`: the engine fetches
  // nothing and assumes no namespace. `trigger` is the toggle's aria-label.
  texts?: { trigger?: string }
}

const { flag: Flag, triggerIcon: TriggerIcon, activeIcon: ActiveIcon, classes = {}, texts } = Astro.props
const { uiLocale: currentLang } = Astro.locals
---

<language-switcher
  data-current-lang={currentLang}
  data-cookie-name={LANG_COOKIE_NAME}
  data-cookie-max-age={I18N_CONFIG.cookie.maxAge}
  data-open="false"
>
  <div class={classes.root}>
    <button
      type="button"
      data-ls-trigger
      class={classes.trigger}
      aria-haspopup="true"
      aria-expanded="false"
      aria-label={texts?.trigger ?? 'Switch language'}
    >
      {
        TriggerIcon ? (
          <TriggerIcon class={classes.triggerIcon} stroke-width="1" />
        ) : (
          <svg
            class={classes.triggerIcon}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <ellipse cx="12" cy="12" rx="4" ry="9" />
            <path d="M3 12h18" />
          </svg>
        )
      }
    </button>

    <div data-ls-dropdown class={classes.dropdown} role="menu" hidden>
      {
        SUPPORTED_LOCALES.map((lang) => {
          const locale = lang as Locale
          const isActive = locale === currentLang
          const label = LANGUAGES[locale]
          const flagCode = label.countryCode

          // The label is the language's own name: `lang` lets a screen reader say it in that
          // language. (A comment here, not among the button's children: there it splits the
          // whitespace run, and compressHTML keeps two spaces before the label.)
          return (
            <button
              type="button"
              class:list={[classes.item, isActive && classes.itemActive]}
              data-ls-item
              data-lang={locale}
              data-active={isActive ? 'true' : undefined}
              role="menuitem"
              disabled={isActive}
            >
              <span class={classes.itemLabel} lang={locale}>
                {Flag && flagCode && <Flag code={flagCode} size={16} />}
                {label.name}
              </span>
              {isActive &&
                (ActiveIcon ? (
                  <ActiveIcon class={classes.activeIcon} />
                ) : (
                  <svg class={classes.activeIcon} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <circle cx="12" cy="12" r="3" />
                  </svg>
                ))}
            </button>
          )
        })
      }
    </div>
  </div>
</language-switcher>

<script>
  // Config arrives as data attributes on the element: a client script in the engine
  // cannot import the project's config.
  import type { Locale } from '../constants'

  class LanguageSwitcher extends HTMLElement {
    private trigger: HTMLButtonElement | null = null
    private dropdown: HTMLElement | null = null

    connectedCallback() {
      this.trigger = this.querySelector('[data-ls-trigger]')
      this.dropdown = this.querySelector('[data-ls-dropdown]')

      if (!this.trigger || !this.dropdown) return

      this.trigger.addEventListener('click', this.onToggle)
      this.dropdown.addEventListener('click', this.onSelect)
    }

    disconnectedCallback() {
      this.trigger?.removeEventListener('click', this.onToggle)
      this.dropdown?.removeEventListener('click', this.onSelect)
      this.removeGlobalListeners()
    }

    private open() {
      if (!this.dropdown || !this.trigger) return
      this.dropdown.hidden = false
      this.dataset.open = 'true'
      this.trigger.setAttribute('aria-expanded', 'true')

      document.addEventListener('click', this.onDocumentClick)
      document.addEventListener('keydown', this.onKeyDown)
    }

    private close() {
      if (!this.dropdown || !this.trigger) return
      this.dropdown.hidden = true
      this.dataset.open = 'false'
      this.trigger.setAttribute('aria-expanded', 'false')

      this.removeGlobalListeners()
    }

    private removeGlobalListeners() {
      document.removeEventListener('click', this.onDocumentClick)
      document.removeEventListener('keydown', this.onKeyDown)
    }

    private onToggle = (e: MouseEvent) => {
      e.stopPropagation()
      if (!this.dropdown) return

      this.dropdown.hidden ? this.open() : this.close()
    }

    // Isolated logic for getting language from URL
    private getLangFromUrl(pathname: string): string | undefined {
      const segments = pathname.split('/')
      return segments[1] || undefined
    }

    // Isolated logic for substituting language in URLs
    private replaceLocaleInPath(pathname: string, currentLang: string, targetLang: string): string {
      const segments = pathname.split('/')
      if (segments[1] === currentLang) {
        segments[1] = targetLang
      }
      return segments.join('/')
    }

    private onSelect = (event: Event) => {
      const target = event.target as HTMLElement
      const button = target.closest<HTMLButtonElement>('[data-ls-item]')
      if (!button) return

      const lang = button.dataset.lang as Locale | undefined
      if (!lang) return

      const pathname = window.location.pathname
      const currentLang = this.getLangFromUrl(pathname)

      if (!currentLang) return

      const { cookieName, cookieMaxAge } = this.dataset

      // Persist the EXPLICIT language choice client-side. The i18n middleware
      // no longer creates the cookie on plain page views (a cookie-less request
      // must stay free of Set-Cookie so the HTML edge cache can serve it), so
      // the switcher is the place where the preference is born. Not httpOnly on
      // either side (cookie-storage.ts): the server validates it, never trusts it.
      document.cookie = `${cookieName}=${lang}; path=/; max-age=${cookieMaxAge}; SameSite=Lax; Secure`

      window.location.href = this.replaceLocaleInPath(pathname, currentLang, lang)
    }

    private onDocumentClick = (event: MouseEvent) => {
      if (!this.contains(event.target as Node)) {
        this.close()
      }
    }

    private onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        this.close()
      }
    }
  }

  if (!customElements.get('language-switcher')) {
    customElements.define('language-switcher', LanguageSwitcher)
  }
</script>
