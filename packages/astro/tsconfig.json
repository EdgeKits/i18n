{
  "extends": "astro/tsconfigs/strict",
  "include": ["src/**/*", "test/**/*"],
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": true,
    "types": ["@cloudflare/workers-types", "node", "astro/client"]
  }
}
