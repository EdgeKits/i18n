{
  // Emits the Node-side code (config-time entry, integration, CLI) to dist/ with
  // declarations. Runtime code and components ship as source (ADR-0004).
  "extends": "./tsconfig.json",
  "include": ["src/index.ts", "src/integration/**/*", "src/cli/**/*"],
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "types": ["@cloudflare/workers-types", "node"]
  }
}
