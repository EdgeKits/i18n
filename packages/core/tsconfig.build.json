{
  // Emits the whole package to dist/ with declarations: the factory, the pure helpers and
  // the CLI. Nothing ships as source.
  "extends": "./tsconfig.json",
  "include": ["src/**/*"],
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  }
}
