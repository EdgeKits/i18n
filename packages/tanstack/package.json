{
  "name": "@edgekits/tanstack-i18n",
  "version": "0.2.0",
  "description": "Edge-native i18n for TanStack Start on Cloudflare Workers: a Hono locale middleware, a translations loader for server functions, and a React provider over the EdgeKits engine.",
  "keywords": [
    "tanstack",
    "tanstack-start",
    "react",
    "hono",
    "i18n",
    "cloudflare",
    "cloudflare-workers",
    "kv",
    "edge"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Gary Stupak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdgeKits/i18n.git",
    "directory": "packages/tanstack"
  },
  "homepage": "https://github.com/EdgeKits/i18n/tree/main/packages/tanstack#readme",
  "bugs": {
    "url": "https://github.com/EdgeKits/i18n/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test test/**/*.test.ts test/**/*.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@edgekits/i18n-core": "0.2.0"
  },
  "peerDependencies": {
    "hono": "^4",
    "react": "^19"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "hono": "^4.13.14",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
